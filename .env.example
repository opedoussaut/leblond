# ─────────────────────────────────────────────────────────────────────────────
# LEBLOND environment variables. Copy to `.env.local` for local development.
# NEVER commit real values. The repository is public.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the beta bootstrap script, admin actions and token storage.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployment (used for auth email redirects and OAuth callbacks).
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Patrick “Le Blond” — model provider (server-only). Pick ONE option.
#
# Option 1 (default) — OpenAI Responses API:
COACH_PROVIDER=openai
OPENAI_API_KEY=
# Model name of your choice. Not hard-coded.
OPENAI_MODEL=
#
# Option 2 — an open-weight model behind any OpenAI-compatible Chat Completions
# server. Self-hosted (Ollama, LM Studio, llama.cpp, vLLM): no API key needed.
# Hosted open-model APIs (Groq, Mistral, OpenRouter, GitHub Models…): put their key in COACH_API_KEY.
#   COACH_PROVIDER=openai-compatible
#   COACH_BASE_URL=http://localhost:11434/v1     (Ollama)
#   COACH_MODEL=qwen3:8b
#   COACH_API_KEY=
COACH_BASE_URL=
COACH_MODEL=
COACH_API_KEY=
MAX_COACH_REQUESTS_PER_USER_PER_DAY=30

# Closed beta whitelist — consumed only by `npm run beta:bootstrap`.
BETA_OLIVIER_EMAIL=
BETA_THOMAS_EMAIL=
BETA_MARC_EMAIL=
BETA_HOUSSEM_EMAIL=
BETA_DAVID_EMAIL=

# 32-byte key, base64-encoded, for AES-256-GCM encryption of wearable OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Wearables ────────────────────────────────────────────────────────────────
# A provider stays "Requires provider approval" until its credentials AND
# endpoints are configured. Endpoints for partner programmes are supplied with
# the provider's partner documentation and are therefore configurable.
# <PROVIDER>_API_ENV = production | development (development shows "Development/testing").

# COROS Partner API (endpoints are provided by COROS after partner approval)
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=
COROS_AUTHORIZE_URL=
COROS_TOKEN_URL=
COROS_API_ENV=

# Suunto Cloud API (apizone.suunto.com)
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_REDIRECT_URI=
SUUNTO_API_ENV=

# Garmin Connect Developer Program
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_API_ENV=

# Strava — planned for the next milestone (adapter interface only in V1)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
